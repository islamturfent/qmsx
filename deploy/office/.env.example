# Docker Compose trial only; this file does NOT configure Apache/PHP automatically.
CODE_IMAGE=collabora/code:latest
QMS_WOPI_ORIGIN=http://host.docker.internal:80

# Corresponding QMS environment settings, or enter them in office-settings.php.
# Keep disabled until installation and end-to-end checks have succeeded.
QMS_OFFICE_ENABLED=false
QMS_OFFICE_PROVIDER=collabora
QMS_OFFICE_PUBLIC_URL=http://localhost:9980
QMS_OFFICE_DISCOVERY_URL=http://localhost:9980/hosting/discovery
QMS_OFFICE_QMS_URL=http://host.docker.internal/qms
QMS_OFFICE_HOST_URL=http://localhost/qms
# Replace with the actual REMOTE_ADDR observed from the container; never use '*'.
QMS_OFFICE_CALLBACK_IPS=127.0.0.1,::1
QMS_OFFICE_REQUIRE_PROOF=true
QMS_OFFICE_ALLOW_HTTP=true
QMS_OFFICE_TOKEN_TTL=1800
QMS_OFFICE_MAX_BYTES=10485760
